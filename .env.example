# Credentials must belong to the same account. Leave unused scopes empty.
RELIQUARY_API_URL=https://app.reliqua.ai
RELIQUARY_RESOURCES_KEY=
RELIQUARY_ORDERS_KEY=
RELIQUARY_EVALUATIONS_KEY=
RELIQUARY_TRAINING_KEY=
RELIQUARY_ENABLE_WRITES=false
RELIQUARY_TRANSPORT=stdio
RELIQUARY_TIMEOUT_MS=30000

# HTTP only: generate a separate random token (at least 32 characters).
RELIQUARY_MCP_TOKEN=
RELIQUARY_HTTP_HOST=127.0.0.1
RELIQUARY_PORT=3000
# Required with external binding; terminate TLS at the reverse proxy.
RELIQUARY_PUBLIC_URL=
