{
  "name": "@reliquadotai/mcp",
  "version": "0.12.1",
  "mcpName": "io.github.reliquadotai/reliquary-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reliquadotai/reliquary-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "description": "Account-scoped MCP interface for Reliquary",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reliquary-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test && npm audit --omit=dev --audit-level=high",
    "start": "node dist/index.js",
    "smoke:live": "node scripts/smoke-live.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@reliquary/api": "file:vendor/api-client-0.12.0.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "vendor/api-client-0.12.0.tgz",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bundleDependencies": [
    "@modelcontextprotocol/node",
    "@modelcontextprotocol/server",
    "@reliquary/api",
    "zod"
  ]
}
